generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // CHANGED FROM sqlite
  url      = env("DATABASE_URL") // CHANGED FROM file:./dev.db
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  username  String?   @unique
  password  String
  createdAt DateTime  @default(now())
  sessions  Session[]
  stats     Stats?
  dailyStats DailyStats[]
  missions   Mission[]
  profileImageUrl    String?
  themeColor         String    @default("violet-500")
  backgroundGradient String    @default("bg-[#030305]")
  textColor          String    @default("text-white")
  usernameFont       String    @default("font-sans")
  backgroundStyle    String    @default("bg-none")
  links              UserLink[]
  tokens             Int       @default(0)
  unlocks            UserUnlock[]
  activeBadge        String?
  personalGoals      PersonalGoal[]
}

model UserLink {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // "github", "linkedin", "website", "custom"
  url       String
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskTitle        String
  duration         Int       // in minutes
  status           String    // "SUCCESS" or "FAILED"
  distractionCount Int       @default(0)
  inactiveDuration Int       @default(0) // in seconds
  startedAt        DateTime  @default(now())
  endedAt          DateTime?
}

model Stats {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalXP       Int      @default(0)
  level         Int      @default(1)
  currentStreak Int      @default(0)
  bestStreak    Int      @default(0)
  lastSessionAt DateTime?
}

model DailyStats {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date              DateTime
  totalFocusMinutes Int      @default(0)
  sessionsCount     Int      @default(0)

  @@unique([userId, date])
}

model Mission {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // e.g. "SESSIONS_COUNT", "FOCUS_MINUTES"
  target    Int
  progress  Int      @default(0)
  completed Boolean  @default(false)
  date      DateTime
}

model PersonalGoal {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  type      String   // FOCUS_MINUTES, SESSIONS_COUNT
  period    String   // DAILY, MONTHLY
  target    Int
  progress  Int      @default(0)
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
}


model Match {
  id       String  @id @default(cuid())
  user1Id  String
  user2Id  String
  status   String  // "PENDING", "ACTIVE", "COMPLETED"
  winnerId String?
}

model UserUnlock {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // "font", "color", "background", "badge", "feature"
  itemId    String
  createdAt DateTime @default(now())

  @@unique([userId, type, itemId])
}
